# Expo SDK 56 pins react@19.2.3 while a web-only transitive (react-dom@19.2.7) requests
# react@^19.2.7. That peer mismatch only affects the unused web target, not the native
# app, but npm 11's strict peer resolution would otherwise block `npm install`.
# legacy-peer-deps keeps a plain `npm install` / `npx expo install` working from a clean
# clone. No secrets or registry credentials are configured here.
legacy-peer-deps=true
