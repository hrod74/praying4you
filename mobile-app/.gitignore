# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files & Firebase config — never commit real values or keys.
# The placeholder .env.example IS committed (it has no real values).
.env
.env.*
!.env.example
# Firebase native/admin config files (not used in the Expo Go MVP; ignored as a safeguard).
google-services.json
GoogleService-Info.plist
serviceAccountKey.json
firebase-adminsdk*.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
