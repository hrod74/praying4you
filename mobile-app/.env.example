# Praying For You — Firebase web config (PLACEHOLDERS ONLY)
#
# This example file is safe to commit. It contains NO real values.
# To run against the real Firebase project later:
#   1. Copy this file to ".env.local" (which is gitignored and never committed).
#   2. Fill in the real values from the Firebase console (Project settings > Your apps > Web app).
# Never commit real values, and never paste them into chat tools or screenshots.
# See docs/firebase-implementation-readiness.md for the full policy.
#
# Expo inlines EXPO_PUBLIC_* variables at build time (compatible with Expo Go).
# Until these are set, the app stays fully local/mock (Firebase is not initialized).

EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_AUTH_DOMAIN
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_STORAGE_BUCKET
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_APP_ID
# Optional (Analytics). Leave blank if unused.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
