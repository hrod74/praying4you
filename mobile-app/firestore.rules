rules_version = '2';

// Praying For You — Firestore Security Rules (Alpha)
//
// Scope so far:
//   - users/{uid}              private profile document (Phase J.2c) — owner-only.
//   - prayerRequests/{id}      prayer requests (Phase J.2e) — signed-in read of active requests;
//                              owner-only create/edit/soft-remove; a controlled +1 to prayerCount
//                              tied to a new interaction (Phase J.2f.3).
//   - prayerInteractions/{id}  "I prayed for this" (Phase J.2f.3) — one per user+request, id is
//                              `{uid}_{requestId}`; owner can create + read only their own; no
//                              client update/delete; AGGREGATE-ONLY (no "who prayed" listing).
//   - reports/{id}             "report this request" (Phase J.2g) — one per reporter+request, id is
//                              `{uid}_{requestId}`; reporter-only create + read-own; no list, no
//                              client status change/delete. Private moderation record reviewed
//                              MANUALLY in the Firebase Console (no "who reported" surface anywhere).
//
// IMPORTANT: these rules are NOT auto-deployed. The owner must publish the FULL contents of this
// file in the Firebase Console (Firestore Database > Rules > Publish) or via the Firebase CLI for
// them to take effect.
//
// Privacy invariants enforced/assumed here:
//   - users/{uid} is owner-only; no user can read another user's profile.
//   - Email is never stored in Firestore (Auth owns it), and neither a prayer request nor a prayer
//     interaction may contain an `email` field (enforced on create + update below).
//   - prayerRequests carry `authorUid` for ownership/moderation; it is an opaque UID and is never
//     shown in the UI. The real name behind an anonymous post is not stored on the request.
//   - prayerInteractions store only the user's own `userUid`, the `requestId`, and metadata — never
//     an email or a display name. A user can read only their OWN interaction; there is no query or
//     rule that exposes the list of who prayed for a request. The only cross-user signal is the
//     aggregate `prayerCount` on the request.
//   - prayerCount can only ever change by exactly +1, and only in the same atomic commit that
//     creates the praying user's brand-new interaction doc (so it can never be inflated directly).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Private user profile — owner-only. The document id IS the user's UID, so requiring
    // request.auth.uid == uid is sufficient to guarantee a user only touches their own profile.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid); // account-deletion phase (J.2d)
    }

    // Prayer requests (Phase J.2e).
    match /prayerRequests/{requestId} {
      // READ: any signed-in user may read an ACTIVE request (the shared feed). An owner may also
      // read their own request in any status. Soft-removed requests are not readable by others.
      allow read: if isSignedIn()
        && (resource.data.status == 'active' || resource.data.authorUid == request.auth.uid);

      // CREATE: a signed-in user may create only their OWN request, starting active with a zero
      // count and safe field shapes, and may NOT include an email field.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.prayerCount == 0
        && request.resource.data.isAnonymous is bool
        && request.resource.data.body is string
        && request.resource.data.category is string
        && request.resource.data.displayName is string
        && !('email' in request.resource.data);

      // UPDATE (edit + soft-remove): owner only. Protected fields (authorUid, createdAt,
      // prayerCount) must not change, status must stay within the allowed set, and no email may be
      // introduced. This rule never lets a client change prayerCount; the controlled +1 lives in the
      // separate "pray" rule below.
      allow update: if isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.prayerCount == resource.data.prayerCount
        && request.resource.data.status in ['active', 'removed']
        && !('email' in request.resource.data);

      // UPDATE (pray): any signed-in user may raise prayerCount by exactly +1 — and ONLY
      // prayerCount — on an ACTIVE request, but only in the SAME atomic commit that creates their
      // own brand-new interaction doc. `existsAfter` requires the interaction to exist after the
      // commit; `!exists` requires it did not exist before (so a given user can do this at most
      // once per request). This is what makes the count tamper-resistant: it can never be inflated
      // without a matching, first-time, per-user interaction. Multiple `allow update` blocks are
      // OR'd, so this does not weaken the owner-only edit rule above.
      //
      // NOTE for the client: the +1 MUST be written as a literal number (resource.data.prayerCount
      // + 1), NOT FieldValue.increment(1). A server-side increment transform is not a concrete value
      // during rule evaluation, so the exact-value check below would fail and reject the update —
      // and, since pray runs in a transaction, that would roll back the interaction create too. See
      // prayerInteractionService.pray.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayerCount'])
        && request.resource.data.prayerCount == resource.data.prayerCount + 1
        && resource.data.status == 'active'
        && !exists(/databases/$(database)/documents/prayerInteractions/$(request.auth.uid + '_' + requestId))
        && existsAfter(/databases/$(database)/documents/prayerInteractions/$(request.auth.uid + '_' + requestId));

      // No client deletes: removal is a soft remove (status -> removed), never a hard delete.
      allow delete: if false;
    }

    // Prayer interactions ("I prayed for this") — Phase J.2f.3. One doc per user+request, with the
    // deterministic id `{uid}_{requestId}` so a user can never create a duplicate. AGGREGATE-ONLY to
    // others: a user may read only their OWN interaction, and there is no rule that lets anyone list
    // who prayed for a request.
    match /prayerInteractions/{interactionId} {
      // GET (single doc): a user may read ONLY their own deterministic interaction doc, identified by
      // the id prefix `{uid}_`. This is authorized from the document ID, NOT from `resource.data`, so
      // it works even when the document does NOT exist yet. That matters because the pray transaction
      // reads `prayerInteractions/{uid}_{requestId}` first to prevent a duplicate: a get of a missing
      // doc has `resource == null`, so a `resource.data.userUid` check alone would error and deny it
      // (the permission-denied seen on BatchGetDocuments). The prefix check still blocks reading
      // another user's doc, because a doc id starting with someone else's uid can never match.
      allow get: if isSignedIn()
        && interactionId[0:(request.auth.uid.size() + 1)] == (request.auth.uid + '_');

      // LIST (query): allowed only when every matched doc is the caller's own (userUid == uid), which
      // is exactly how `listMinePrayedFor` queries. Matched docs always exist, so the resource check
      // is valid here. There is deliberately no rule that lets anyone enumerate who prayed for a
      // request.
      allow list: if isSignedIn() && resource.data.userUid == request.auth.uid;

      // CREATE: a signed-in user may create only their OWN interaction. The doc id must be
      // `{uid}_{requestId}`, userUid must be the caller, no email may be stored, and the target
      // request must exist and be ACTIVE (so no one can pray for a removed/missing request). The
      // matching +1 to prayerCount is authorized by the "pray" update rule above, in the same commit.
      allow create: if isSignedIn()
        && request.resource.data.userUid == request.auth.uid
        && interactionId == (request.auth.uid + '_' + request.resource.data.requestId)
        && !('email' in request.resource.data)
        && exists(/databases/$(database)/documents/prayerRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/prayerRequests/$(request.resource.data.requestId)).data.status == 'active';

      // No client updates or deletes: an interaction is immutable from the client (no "un-pray" in
      // this phase), which also keeps the aggregate prayerCount consistent.
      allow update, delete: if false;
    }

    // Reports ("report this request") — Phase J.2g. One doc per reporter+request, deterministic id
    // `{uid}_{requestId}`. A PRIVATE moderation record reviewed MANUALLY in the Firebase Console
    // (Console access bypasses these rules). From the client a reporter may create their own report
    // and read ONLY their own report (for duplicate handling); no one may list reports, read another
    // user's report, change a report's status, or delete a report.
    match /reports/{reportId} {
      // GET (single doc): a reporter may read ONLY their own deterministic report doc, authorized
      // from the id prefix `{uid}_` (works even before it exists, for the duplicate pre-check). The
      // prefix check blocks reading another user's report.
      allow get: if isSignedIn()
        && reportId[0:(request.auth.uid.size() + 1)] == (request.auth.uid + '_');

      // LIST: never. There is deliberately no "who reported" surface anywhere in the app.
      allow list: if false;

      // CREATE: a signed-in user may file ONLY their own report, on someone else's ACTIVE request,
      // once. The doc id must be `{uid}_{requestId}`; reporterUid must be the caller; status starts
      // `open`; the reason must be one of the app's allowed reasons; ONLY the known fields may be
      // present (hasOnly => no email / display name / phone / device id); and the target request must
      // exist, be active, and have an author who is NOT the reporter (cannot report your own request).
      // Duplicates are impossible: the id is deterministic and `update` is denied, so a second write
      // is an update and is rejected.
      allow create: if isSignedIn()
        && reportId == (request.auth.uid + '_' + request.resource.data.requestId)
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['spam', 'inappropriate', 'harmful', 'other']
        && request.resource.data.keys().hasOnly(
             ['id', 'reporterUid', 'requestId', 'requestAuthorUid', 'reason', 'status', 'createdAt', 'schemaVersion', 'notes'])
        && !('email' in request.resource.data)
        && exists(/databases/$(database)/documents/prayerRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/prayerRequests/$(request.resource.data.requestId)).data.status == 'active'
        && get(/databases/$(database)/documents/prayerRequests/$(request.resource.data.requestId)).data.authorUid == request.resource.data.requestAuthorUid
        && request.resource.data.requestAuthorUid != request.auth.uid;

      // No client status changes and no deletes: moderation/review is manual via the Console.
      allow update, delete: if false;
    }

    // Everything else is denied until its phase adds explicit rules + tests.
    // No broad public access, no unauthenticated access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
