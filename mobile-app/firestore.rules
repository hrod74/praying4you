rules_version = '2';

// Praying For You — Firestore Security Rules (Alpha, Phase J.2c, simplified in the J.2c sync fix)
//
// Scope: the private user profile document at `users/{uid}` ONLY.
// Prayer requests, prayer interactions, and reports are NOT in Firestore yet; they stay denied by
// the catch-all rule below until their own phases add explicit rules + emulator tests.
//
// IMPORTANT: these rules are NOT auto-deployed. The owner must publish them in the Firebase
// Console (Firestore Database > Rules) or via the Firebase CLI for them to take effect.
//
// Why this version is simpler than the first draft: the earlier draft over-validated profile
// CREATE (it required `profileVersion is int` and exact `serverTimestamp() == request.time`
// matches). Those checks rejected otherwise-valid writes with permission-denied, so no
// `users/{uid}` doc was ever created. For Alpha we keep an owner-only model based purely on the
// authenticated UID, which is what actually matters for privacy. Field-shape hardening can return
// later with emulator tests to prove it does not reject valid writes.
//
// Access model (owner-only; no public, no unauthenticated access):
//   - A signed-in user can READ, CREATE, UPDATE, and DELETE only their own users/{uid} profile.
//     (DELETE is allowed so the next phase, account deletion, can remove the profile doc.)
//   - No user can read, create, update, or delete another user's profile.
//   - Everything else remains denied.
//   - Email is never stored in this document.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Private user profile — owner-only. The document id IS the user's UID, so requiring
    // request.auth.uid == uid is sufficient to guarantee a user only touches their own profile.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid); // for the upcoming account-deletion phase
    }

    // Everything else (prayerRequests, prayerInteractions, reports, ...) is denied until its
    // phase adds explicit rules + emulator tests. No broad public access, no unauthenticated access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
